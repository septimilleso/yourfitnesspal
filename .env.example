# Server secret for login challenges and TOTP encryption (not a password).
# Changing it invalidates all sessions and TOTP configuration.
APP_KEY=change-me-to-a-long-random-string

# Async SQLAlchemy connection string for the api service, pointing at the
# db service on the compose network.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/yourfitnesspal

# Contact email sent to OpenFoodFacts as required by their API usage policy.
OFF_CONTACT_EMAIL=you@example.com

# Optional VAPID keys for rest-finished Web Push. Without all three values,
# push alerts are disabled and the rest of the app continues to work.
# Generate a key pair from the repository root with:
#   docker compose exec -T api python - < api/scripts/gen_vapid_keys.py
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:you@example.com

# Session cookie's `Secure` flag. Leave at true (default, can be omitted)
# whenever the app is served over HTTPS -- always the case once behind the
# Cloudflare Tunnel. Only set to false for temporary plain-HTTP testing
# before a tunnel/TLS is in place; browsers silently drop `Secure` cookies
# received over plain HTTP, which looks like "login doesn't work".
#COOKIE_SECURE=false

# Public HTTPS origin of the app (the Cloudflare Tunnel hostname). Used as the
# OAuth issuer and to build the MCP URL users paste into Claude:
# <PUBLIC_BASE_URL>/mcp. Must match exactly what users open in the browser.
PUBLIC_BASE_URL=https://fit.example.com

# Timezone the MCP tools use to decide what "today" is.
#APP_TIMEZONE=Europe/Rome
# Lifetime of MCP access/refresh tokens.
#OAUTH_ACCESS_TOKEN_MINUTES=60
#OAUTH_REFRESH_TOKEN_DAYS=30
