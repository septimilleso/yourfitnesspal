# Secret key used to sign sessions/cookies.
APP_KEY=change-me-to-a-long-random-string

# Async SQLAlchemy connection string for the api service, pointing at the
# db service on the compose network.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/yourfitnesspal

# Contact email sent to OpenFoodFacts as required by their API usage policy.
OFF_CONTACT_EMAIL=you@example.com
